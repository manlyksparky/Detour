# Optional. Map tile style URL. Defaults to the OpenFreeMap "Liberty" style, re-dressed to Detour's palette.
NEXT_PUBLIC_BASEMAP_STYLE=

# Optional. Terrarium-encoded elevation tiles for 3D terrain. Defaults to the public Mapzen tiles
# on AWS Open Data; set it to an empty string to switch terrain off.
NEXT_PUBLIC_TERRAIN_TILES=

# Optional. Server-side only: enables Claude narration on walking tours.
# Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Server-side only: a Valhalla routing endpoint for walking routes between tour stops.
# Defaults to the public OpenStreetMap demo server, which is fine for development but not for traffic.
ROUTING_URL=
